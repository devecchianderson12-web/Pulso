{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The title bar and WhatsApp Web may call Pulso's own commands.",
  "windows": [
    "main"
  ],
  "webviews": [
    "shell",
    "wa"
  ],
  "remote": {
    "urls": [
      "https://web.whatsapp.com",
      "https://web.whatsapp.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-page-focus",
    "allow-page-notified",
    "allow-notify",
    "allow-set-unread-count",
    "allow-update-state",
    "allow-update-action",
    "allow-options",
    "allow-set-option",
    "allow-set-gpu",
    "allow-set-language",
    "allow-page-action",
    "allow-save-theme",
    "allow-icon-info-cmd",
    "allow-save-icon",
    "allow-save-icon-file",
    "allow-open-external",
    "allow-zoom",
    "allow-toggle-fullscreen",
    "allow-hide-window",
    "allow-quit-app",
    "allow-devtools",
    "allow-shell-state",
    "allow-shell-control",
    "allow-start-drag",
    "allow-start-resize"
  ]
}