{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulso Rust",
  "version": "../package.json",
  "identifier": "com.pulso.rust",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Pulso",
    "shortDescription": "Pulso: tu WhatsApp, en tu estilo",
    "longDescription": "Cliente de escritorio no oficial de WhatsApp para Windows, escrito en Rust.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
