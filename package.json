{
  "name": "pulso",
  "productName": "Pulso",
  "version": "1.3.0",
  "description": "Pulso: tu WhatsApp, en tu estilo. Cliente de escritorio no oficial para Windows",
  "main": "src/main.js",
  "license": "GPL-3.0-or-later",
  "author": "Pulso",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "pack": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pulso.windows",
    "productName": "Pulso",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "devecchianderson12-web",
        "repo": "Pulso",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Pulso-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulso",
      "guid": "a2af60dd-1c7c-5626-8f90-c920723e6566"
    },
    "portable": {
      "artifactName": "Pulso-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
